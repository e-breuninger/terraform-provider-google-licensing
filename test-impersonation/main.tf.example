terraform {
  required_providers {
    google = {
      source = "hashicorp/google"
    }
    googleenterpriselicense = {
      source  = "e-breuninger/google-licensing"
      version = "~> 0.2"
    }
  }
}

# Provider for GCP impersonation — uses the caller's own ADC identity to mint a
# short-lived token for the target service account.
provider "google" {
  alias = "impersonation"
  scopes = [
    "https://www.googleapis.com/auth/cloud-platform",
    "https://www.googleapis.com/auth/userinfo.email",
  ]
}

# Service account access token for the licensing automation identity.
data "google_service_account_access_token" "default" {
  provider                = google.impersonation
  target_service_account  = "license-provisioning@my-provisioning-project.iam.gserviceaccount.com"
  scopes                  = ["userinfo-email", "cloud-platform"]
  lifetime                = "1200s"
}

provider "googleenterpriselicense" {
  access_token = data.google_service_account_access_token.default.access_token
}

# Read-only check: import an existing assignment using the impersonated
# identity, to confirm it has permission to read Gemini Enterprise license
# assignments on the target project.
import {
  to = googleenterpriselicense_gemini_user_license.example_gemini
  id = "my-gcp-project/eu/bob@example.com"
}

resource "googleenterpriselicense_gemini_user_license" "example_gemini" {
  project        = "my-gcp-project"
  location       = "eu"
  user_id        = "bob@example.com"
  license_config = "projects/PROJECT_NUMBER/locations/eu/licenseConfigs/GEMINI_CONFIG_ID"
}
